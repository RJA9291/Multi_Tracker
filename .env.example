APP_NAME="Multi Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://multi_tracker.on-forge.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multi_tracker
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

SANCTUM_STATEFUL_DOMAINS=multi_tracker.on-forge.com
